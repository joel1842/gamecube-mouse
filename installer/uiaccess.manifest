<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Manifest for the Program Files copy: uiAccess lets it send input to admin windows and prompts,
     like Windows' own On-Screen Keyboard. Windows only honours it for a signed exe in Program Files. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="GameCubeMouse.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="true" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
